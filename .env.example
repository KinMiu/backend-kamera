# ==============================================================================
# Database Configuration
# ==============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/kamera-waykambas"

# ==============================================================================
# Server Port & Security
# ==============================================================================
PORT=3001

# JWT Secrets for User Session Management
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=1d

# Initial Superadmin Credentials for Database Seeding
SEED_ADMIN_EMAIL="superadmin@DST.com"
SEED_ADMIN_PASSWORD="superadmin123"

# ==============================================================================
# Global API Key Security (Required for all incoming requests)
# ==============================================================================
API_KEY_HEADER=x-api-key
API_KEYS=AE6F9iZuCyMpIf4wi7zxA8nSgfONFBXg

# ==============================================================================
# MQTT Broker Configuration for Worker Real-Time Sync
# ==============================================================================
MQTT_BROKER=tcp://195.35.23.135:1883
MQTT_USERNAME=/smk2pkl:smk2iot
MQTT_PASSWORD=smk2iot
MQTT_CLIENT_ID=backend_waykambas_server
MQTT_WORKER_TOPIC=workers/worker_cabang_01/events
MQTT_BROADCAST_TOPIC=workers/events

