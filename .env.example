# ==============================================================================
# Database Configuration
# ==============================================================================
DATABASE_URL="postgresql://username:password@localhost:5432/kamera_waykambas"

# ==============================================================================
# Server Port & Security
# ==============================================================================
PORT=3001

# JWT Secrets for User Session Management
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRES_IN=1d

# Initial Superadmin Credentials for Database Seeding
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_this_admin_password

# ==============================================================================
# Global API Key Security (Comma-separated for multiple valid keys)
# ==============================================================================
API_KEY_HEADER=x-api-key
API_KEYS=your_api_key_1,your_api_key_2

# ==============================================================================
# MQTT Broker Configuration for Worker Real-Time Sync
# ==============================================================================
MQTT_BROKER=tcp://localhost:1883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_CLIENT_ID=backend_waykambas_server
MQTT_WORKER_TOPIC=workers/worker_01/events
MQTT_BROADCAST_TOPIC=workers/events
